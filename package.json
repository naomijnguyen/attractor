{
  "name": "attractor",
  "version": "0.1.0",
  "description": "A persistent topological memory structure that tracks how modes of engagement evolve across conversations.",
  "type": "module",
  "license": "MIT",
  "author": "Jennifer Naomi Nguyen",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "example": "esbuild examples/walkthrough.ts --bundle --format=esm --outfile=.wrangler/example.mjs --log-level=error && node .wrangler/example.mjs",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/attractor.mjs --log-level=error && chmod +x dist/attractor.mjs",
    "attractor": "npm run build --silent && node dist/attractor.mjs",
    "web": "npm run web:fixture --silent && vite --config web/vite.config.js",
    "web:live": "ATTRACTOR_LIVE=1 vite --config web/vite.config.js",
    "web:fixture": "esbuild examples/demo-fixture.ts --bundle --platform=node --format=esm --outfile=.wrangler/fixture.mjs --log-level=error && node .wrangler/fixture.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  },
  "bin": {
    "attractor": "./dist/attractor.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
